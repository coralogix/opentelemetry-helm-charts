+
+{{- define "opentelemetry-collector.kubeletStatsConfig" -}}
+{{- $ks := .Values.presets.kubeletStats }}
+receivers:
+  # kubelet /metrics on this node: https on <node-name>:10250, service-account bearer token, self-signed serving cert
+  prometheus/kubelet_stats:
+    config:
+      scrape_configs:
+        - job_name: kubelet-stats
+          scrape_interval: {{ $ks.scrapeInterval }}
+          scheme: https
+          metrics_path: /metrics
+          bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
+          tls_config:
+            insecure_skip_verify: true
+          static_configs:
+            - targets: ["${env:K8S_NODE_NAME}:10250"]
+{{- end }}
+
 {{- define "opentelemetry-collector.applyKubernetesApiServerMetrics" -}}
 {{- $scrapeAll := .Values.Values.presets.kubernetesApiServerMetrics.scrapeAll | default false }}
