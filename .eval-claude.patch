+{{- define "opentelemetry-collector.applyKubeletStatsConfig" -}}
+{{- if ne .Values.Values.mode "daemonset" }}
+{{- fail "[ERROR] presets.kubeletStats requires mode = daemonset (it scrapes the kubelet on the collector's own node)." }}
