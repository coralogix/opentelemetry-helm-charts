+{{- define "opentelemetry-collector.validateKubeletStats" -}}
+{{- $values := .Values.Values -}}
+{{- if ne $values.mode "daemonset" }}
+{{- fail (printf "[ERROR] presets.kubeletStats requires mode=daemonset (got mode=%q) so every node's kubelet /metrics endpoint is scraped." $values.mode) }}
+{{- end }}
+{{- if or (eq $values.distribution "ecs") (eq $values.distribution "standalone") (eq $values.distribution "macos") }}
+{{- fail (printf "[ERROR] presets.kubeletStats requires a Kubernetes distribution (K8S_NODE_NAME and the service-account token are unavailable when distribution=%q)." $values.distribution) }}
+{{- end }}
+{{- if not ((.config.service).pipelines).metrics }}
+{{- fail "[ERROR] presets.kubeletStats requires config.service.pipelines.metrics to be configured." }}
+{{- end }}
+{{- end }}
+
+{{- define "opentelemetry-collector.applyKubeletStatsConfig" -}}
+{{- include "opentelemetry-collector.validateKubeletStats" . -}}
+{{- $config := mustMergeOverwrite (include "opentelemetry-collector.kubeletStatsConfig" .Values | fromYaml) .config }}
+{{- $_ := set $config.service.pipelines.metrics "receivers" (append $config.service.pipelines.metrics.receivers "prometheus/kubelet_stats" | uniq) }}
+{{- $config | toYaml }}
+{{- end }}
+
+{{- define "opentelemetry-collector.kubeletStatsConfig" -}}
+{{- $ks := .Values.presets.kubeletStats -}}
+{{- $scrapeInterval := $ks.scrapeInterval | default "30s" -}}
+{{- if $ks.enabled }}
+receivers:
+  # kubelet /metrics on the local node: https on ${env:K8S_NODE_NAME}:10250 using the service-account token
+  prometheus/kubelet_stats:
+    config:
+      scrape_configs:
+      - job_name: kubelet-stats
+        scrape_interval: {{ $scrapeInterval | quote }}
+        metrics_path: /metrics
+        scheme: https
+        bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
+        static_configs:
+          - targets: ["${env:K8S_NODE_NAME}:10250"]
+        tls_config:
+          ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
+          insecure_skip_verify: true
+{{- end }}
+{{- end }}
+
 {{- define "opentelemetry-collector.applyKubernetesApiServerMetrics" -}}
 {{- $scrapeAll := .Values.Values.presets.kubernetesApiServerMetrics.scrapeAll | default false }}
 {{- $config := mustMergeOverwrite (include "opentelemetry-collector.kubernetesApiServerMetricsConfig" (dict "Values" .Values.Values "scrapeAll" $scrapeAll) | fromYaml) .config }}
