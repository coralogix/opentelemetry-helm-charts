+{{- define "opentelemetry-collector.validateKubeletStats" -}}
+{{- if .presets.kubeletStats.enabled }}
+{{- if ne .mode "daemonset" }}
+{{- fail "[ERROR] presets.kubeletStats requires mode=daemonset to scrape every node." }}
+{{- end }}
+{{- if has .distribution (list "ecs" "standalone" "macos" "eks/fargate") }}
+{{- fail "[ERROR] presets.kubeletStats requires a Kubernetes node with an accessible kubelet." }}
+{{- end }}
+{{- if not .presets.kubeletStats.scrapeInterval }}
+{{- fail "[ERROR] presets.kubeletStats.scrapeInterval must be set (for example, 30s)." }}
+{{- end }}
+{{- end }}
+{{- end }}
+
+{{- define "opentelemetry-collector.applyKubeletStatsConfig" -}}
+{{- $config := mustMergeOverwrite (include "opentelemetry-collector.kubeletStatsConfig" .Values | fromYaml) .config }}
+{{- $_ := set $config.service.pipelines.metrics "receivers" (append $config.service.pipelines.metrics.receivers "prometheus/kubelet_stats" | uniq) }}
+{{- $config | toYaml }}
+{{- end }}
+
+{{- define "opentelemetry-collector.kubeletStatsConfig" -}}
+{{- $preset := .Values.presets.kubeletStats }}
+{{- if $preset.enabled }}
+receivers:
+  # Local kubelet: static target collects each node's own /metrics without discovery.
+  prometheus/kubelet_stats:
+    config:
+      scrape_configs:
+        - job_name: kubelet-stats
+          scrape_interval: {{ $preset.scrapeInterval | quote }}
+          scheme: https
+          metrics_path: /metrics
+          bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
+          tls_config:
+            insecure_skip_verify: true
+          static_configs:
+            - targets: ["${env:K8S_NODE_NAME}:10250"]
+{{- end }}
+{{- end }}
+
 {{- define "opentelemetry-collector.applyKubeletMetricsConfig" -}}
 {{- $config := mustMergeOverwrite (include "opentelemetry-collector.kubeletMetricsConfig" .Values | fromYaml) .config }}
 {{- $_ := set $config.service.pipelines.metrics "receivers" (append $config.service.pipelines.metrics.receivers "kubeletstats" | uniq)  }}
